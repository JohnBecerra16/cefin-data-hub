# Copiar a .env.local. Este archivo solo contiene ejemplos, nunca credenciales reales.
# URL EXTERNA de Railway para conectarse desde Vercel o desde esta computadora.
# En Railway usar el host público para conectar desde Vercel o esta computadora.
# Configurar TLS verificado conforme al proveedor antes de usar datos reales.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Orígenes exactos separados por comas, sin rutas ni barra final.
# HTTP solo se admite para localhost en desarrollo.
ALLOWED_ORIGINS=http://localhost:3000
